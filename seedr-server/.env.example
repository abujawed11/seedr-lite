# Server Configuration
PORT=5000
ROOT=./src/storage/library

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# JWT Secret (Change this to a random string in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# SMTP Email Configuration
# For Gmail: Use App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=abubakar.jawed@gmail.com
SMTP_PASS=breirfymxjsanacc
SMTP_FROM_NAME=Seedr-Lite
SMTP_FROM_EMAIL=abubakar.jawed@gmail.com

# Google reCAPTCHA v3
# Get your keys from: https://www.google.com/recaptcha/admin/create
RECAPTCHA_SECRET_KEY=example-recaptcha-secret-key

# Admin Security Configuration
# IP Whitelist - Comma-separated list of IP addresses allowed to login as admin
# Leave empty or comment out to disable IP restriction
# Examples:
#   Local only: ADMIN_IP_WHITELIST=127.0.0.1
#   Multiple IPs: ADMIN_IP_WHITELIST=127.0.0.1,192.168.1.100,203.0.113.5
# ADMIN_IP_WHITELIST=

# Admin Email for 2FA OTP - Email address that will receive admin login verification codes
# If not set, will use the admin user's email from database
ADMIN_EMAIL=your-admin-email@example.com

# ==================== STORAGE OPTIMIZATION CONFIGURATION ====================

# Redis + BullMQ Configuration (for download queue)
# Use 'redis' as host when running with Docker Compose
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Queue System (BullMQ)
QUEUE_ENABLED=true
QUEUE_MAX_CONCURRENT_GLOBAL=10
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY=60000
QUEUE_JOB_TIMEOUT=3600000

# SSD Space Management
SSD_TOTAL_CAPACITY=107374182400
SSD_RESERVED_FOR_SYSTEM=5368709120
SSD_MAX_DOWNLOAD_SPACE=102005473280
SSD_CHECK_INTERVAL=30000

# Cache System
CACHE_DIR=./src/storage/cache
CACHE_CLEANUP_INTERVAL=86400000
CACHE_RETENTION_DAYS=7
CACHE_MAX_SINGLE_TORRENT_SIZE=107374182400

# Cloudflare R2 Configuration (Optional - enable when ready)
R2_ENABLED=false
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=seedr-lite-storage
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=

# Storage Mode
# local = Store files locally only
# r2 = Store files in R2 only
# hybrid = Store in R2 after download, keep local cache
STORAGE_MODE=local
AUTO_MIGRATE_TO_R2=false
