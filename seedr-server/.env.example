# Server Configuration
PORT=5000
ROOT=./src/storage/library

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# JWT Secret (Change this to a random string in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# SMTP Email Configuration
# For Gmail: Use App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=abubakar.jawed@gmail.com
SMTP_PASS=breirfymxjsanacc
SMTP_FROM_NAME=Seedr-Lite
SMTP_FROM_EMAIL=abubakar.jawed@gmail.com

# Google reCAPTCHA v3
# Get your keys from: https://www.google.com/recaptcha/admin/create
RECAPTCHA_SECRET_KEY=example-recaptcha-secret-key

# Admin Security Configuration
# IP Whitelist - Comma-separated list of IP addresses allowed to login as admin
# Leave empty or comment out to disable IP restriction
# Examples:
#   Local only: ADMIN_IP_WHITELIST=127.0.0.1
#   Multiple IPs: ADMIN_IP_WHITELIST=127.0.0.1,192.168.1.100,203.0.113.5
# ADMIN_IP_WHITELIST=

# Admin Email for 2FA OTP - Email address that will receive admin login verification codes
# If not set, will use the admin user's email from database
ADMIN_EMAIL=your-admin-email@example.com

# Torrent Engine Configuration
# Choose between 'webtorrent' (default) or 'qbittorrent'
TORRENT_ENGINE=webtorrent

# qBittorrent Configuration (only required if TORRENT_ENGINE=qbittorrent)
# URL of qBittorrent WebUI (default: http://localhost:8080)
QBITTORRENT_URL=http://localhost:8080
# qBittorrent WebUI username
QBITTORRENT_USERNAME=admin
# qBittorrent WebUI password
QBITTORRENT_PASSWORD=adminpass
